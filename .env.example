# =============================================================================
# EllaDarie (Vite) — copier vers `.env` ; préfixes exposés : VITE_, PAYDUNIA_
# (voir vite.config.ts → envPrefix)
#
# Hostinger : les variables Vite sont figées au moment de `npm run build`.
# Déployer le contenu de `dist/` dans public_html (avec le .htaccess copié depuis public/).
# =============================================================================

# URL de l’API Express (sans slash final). Si vide :
# - dev → http://localhost:4000/api
# - prod (build) → https://eld-back-express-ts.vercel.app/api
# VITE_API_BASE_URL=http://localhost:4000/api
# VITE_API_BASE_URL=https://eld-back-express-ts.vercel.app/api
VITE_API_BASE_URL=

# Code ISO du pays pour le flux « CFA » au checkout (défaut SN).
# VITE_XOF_PAYMENT_COUNTRY=SN
# VITE_DOHONE_COUNTRY_CODES=GA,TD,CF,CG,GQ
# VITE_PAYDUNYA_COUNTRY_CODES=SN,CI,ML,BJ,BF,TG,NE,GN,LR,SL,CM,GA,CG,TD,CF,CD,GH,NG

# Proxy Vite /paydunya-* : utile en `npm run dev` / `preview` uniquement.
# Sur Hostinger (hébergement statique) : laisser false — le checkout passe par l’API backend.
VITE_PAYDUNYA_USE_RELATIVE_PROXY=false

# --- PayDunya (front : optionnel ; le paiement réel passe par ELDBack) ---
PAYDUNIA_MODE=test

PAYDUNIA_TEST_URL=https://app.paydunya.com/sandbox-api/v1/checkout-invoice/create
PAYDUNIA_TEST_PUBLIC_KEY=
PAYDUNIA_TEST_PRIVATE_KEY=
PAYDUNIA_TEST_TOKEN=

PAYDUNIA_PRODUCTION_URL=https://app.paydunya.com/api/v1/checkout-invoice/create
PAYDUNIA_PRODUCTION_PUBLIC_KEY=
PAYDUNIA_PRODUCTION_PRIVATE_KEY=
PAYDUNIA_PRODUCTION_TOKEN=
