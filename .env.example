# =============================================================================
# EllaDarie (Vite) — copier vers `.env` ; préfixes exposés : VITE_, PAYDUNIA_, EMAILJS_
# (voir vite.config.ts → envPrefix)
# =============================================================================

# URL de l’API Express (sans slash final). Si vide, le front utilise l’API déployée par défaut du projet.
# VITE_API_BASE_URL=http://localhost:4000/api
# VITE_API_BASE_URL=https://votre-api.vercel.app/api
VITE_API_BASE_URL=

# Code ISO du pays pour le flux « CFA » au checkout (défaut SN). Ex. GA pour Gabon → paiement Dohone si listé côté API.
# VITE_XOF_PAYMENT_COUNTRY=SN
# Liste ISO alignée sur ELDBack DOHONE_COUNTRY_CODES (affichage champ téléphone, validation)
# VITE_DOHONE_COUNTRY_CODES=GA,TD,CF,CG,GQ
# Liste ISO alignée sur ELDBack PAYDUNYA_COUNTRY_CODES (texte d’aide « PayDunya » dans l’offcanvas)
# VITE_PAYDUNYA_COUNTRY_CODES=SN,CI,ML,BJ,BF,TG,NE,GN,LR,SL,CM,GA,CG,TD,CF,CD,GH,NG

# true (défaut en dev) : proxy Vite /paydunya-* ; false = appels directs PAYDUNIA_*_URL (attention CORS)
VITE_PAYDUNYA_USE_RELATIVE_PROXY=true

# Optionnel : POST JSON backend pour notification (sinon EmailJS ou mailto)
PAYDUNIA_NOTIFICATION_URL=

# --- PayDunya : interrupteur test / production ---
PAYDUNIA_MODE=test

PAYDUNIA_TEST_URL=https://app.paydunya.com/sandbox-api/v1/checkout-invoice/create
PAYDUNIA_TEST_PUBLIC_KEY=test_public_UzE0PqlVqhjf7bzmStRpmChXgKI
PAYDUNIA_TEST_PRIVATE_KEY=test_private_74LEmZgM65BJLVzuZ5s2ODCoa7M
PAYDUNIA_TEST_TOKEN=7aILsd4vEPOrKU7qu064

PAYDUNIA_PRODUCTION_URL=https://app.paydunya.com/api/v1/checkout-invoice/create
PAYDUNIA_PRODUCTION_PUBLIC_KEY=live_public_h4ug6k8gw19vlgBLyIkxpcgf71t
PAYDUNIA_PRODUCTION_PRIVATE_KEY=live_private_lSDpGBMTTSd9VXD4z2NDjfpquNl
PAYDUNIA_PRODUCTION_TOKEN=xFThh2NhJIWIzfI66ltt

# =============================================================================
# EmailJS — e-mail de livraison à l’acheteur après paiement
# =============================================================================
EMAILJS_PUBLIC_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
