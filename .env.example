# =============================================================================
# EllaDarie (Vite) — copier vers `.env` ; préfixe exposé : VITE_
#
# Hostinger : les variables Vite sont figées au moment de `npm run build`.
# Déployer le contenu de `dist/` dans public_html (avec le .htaccess copié depuis public/).
#
# PayDunya / clés de paiement : uniquement dans ELDBack (.env / Vercel).
# =============================================================================

# URL de l’API Express (sans slash final). Si vide :
# - dev → http://localhost:4000/api
# - prod (build) → https://eld-back-express-ts.vercel.app/api
# VITE_API_BASE_URL=http://localhost:4000/api
# VITE_API_BASE_URL=https://eld-back-express-ts.vercel.app/api
VITE_API_BASE_URL=

# Code ISO du pays pour le flux « CFA » au checkout (défaut SN).
# VITE_XOF_PAYMENT_COUNTRY=SN
# VITE_DOHONE_COUNTRY_CODES=GA,TD,CF,CG,GQ
# Pays couverts par PayDunya (défaut : liste officielle SoftPay)
# VITE_PAYDUNYA_COUNTRY_CODES=SN,CI,BJ,BF,TG,ML,CM

# FeexPay — option « Autre… » au checkout : carte bancaire (Visa / Mastercard) via le widget.
# ID boutique + token API : menu Développeur de votre compte feexpay.me.
# Sans ces clés, l’option « Autre… » affiche un message d’indisponibilité.
VITE_FEEXPAY_SHOP_ID=
VITE_FEEXPAY_TOKEN=
# LIVE ou SANDBOX (tests)
VITE_FEEXPAY_MODE=LIVE
