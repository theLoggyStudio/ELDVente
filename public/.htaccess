# Hostinger / Apache - site Vite SPA (contenu de dist/ -> public_html)
Options -MultiViews
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Fichiers et dossiers reels (assets, favicon, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback SPA -> index.html (retour paiement ?paiement=ok, etc.)
  RewriteRule ^ index.html [L]
</IfModule>

# Pas de cache agressif sur index.html
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
